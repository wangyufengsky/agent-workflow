          "aw-db-readonly": "allow",
          "aw-image-analysis": "allow",
          "aw-page-check": "allow",
          "aw-submit-result": "allow",
        },
        "task": "deny",
        "webfetch": "deny",
      },
      "prompt": "<protocol-review.md>",
    },
    "aw-slides": {
      "description": "agent-workflow slides_writer",
      "mode": "primary",
      "permission": {
        "agent-workflow-app_*": "deny",
        "agent-workflow_browser_submit_report": "deny",
        "edit": "deny",
        "external_directory": "deny",
        "question": "deny",
        "skill": "deny",
        "task": "deny",
        "webfetch": "deny",
        "websearch": "deny",
      },
      "prompt": "<protocol-slides.md>",
    },
  },
  "mcp": {
    "agent-workflow": {
      "enabled": true,
      "headers": {
        "Authorization": "Bearer mcp-token",
      },
      "oauth": false,
      "type": "remote",
      "url": "http://127.0.0.1:4000/mcp/exec",
    },
    "agent-workflow-app": {
      "enabled": true,
      "headers": {
        "Authorization": "Bearer assistant-token",
      },
      "oauth": false,
      "type": "remote",
      "url": "http://127.0.0.1:4000/mcp/assistant",
    },
  },
  "skills": {
    "paths": [
      "/Applications/Agent Workflow.app/Contents/Resources/skills",
    ],
  },
}
`;

exports[`opencode 配置生成 > 离线环境下隐藏 opencode 自带的 provider、禁用 websearch（D168），在线时不设置 1`] = `
{
  "permission": {
    "websearch": "deny",
  },
  "provider": {
    "opencode": {
      "whitelist": [],
    },
    "opencode-go": {
      "whitelist": [],
    },
  },
}
`;
