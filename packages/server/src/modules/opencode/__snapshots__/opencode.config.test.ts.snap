exports[`opencode 配置生成 > 注入 MCP、三个基础 agent 与 bridge 插件 1`] = `
{
  "agent": {
    "aw-executor": {
      "description": "agent-workflow executor",
      "mode": "primary",
      "permission": {
        "edit": "allow",
        "external_directory": "deny",
        "question": "deny",
        "webfetch": "ask",
      },
      "prompt": "<protocol-execute.md>",
    },
    "aw-planner": {
      "description": "agent-workflow planner",
      "mode": "primary",
      "permission": {
        "edit": "deny",
        "external_directory": "deny",
        "question": "deny",
        "webfetch": "deny",
      },
      "prompt": "<protocol-plan.md>",
    },
    "aw-reviewer": {
      "description": "agent-workflow reviewer",
      "mode": "primary",
      "permission": {
        "edit": "deny",
        "external_directory": "deny",
        "question": "deny",
        "webfetch": "deny",
      },
      "prompt": "<protocol-review.md>",
    },
  },
  "mcp": {
    "agent-workflow": {
      "enabled": true,
      "headers": {
        "Authorization": "Bearer mcp-token",
      },
      "oauth": false,
      "type": "remote",
      "url": "http://127.0.0.1:4000/mcp/exec",
    },
  },
  "plugin": [
    "file:///Applications/Agent%20Workflow.app/Contents/Resources/opencode-plugin/agent-workflow-bridge.js",
  ],
}
`;
