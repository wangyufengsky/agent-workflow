exports[`opencode 配置生成 > 注入两套 MCP、三个基础 agent、知识研究员、PPT 写作者、Git 审查员、助手 agent 与 bridge 插件 1`] = `
{
  "agent": {
    "aw-assistant": {
      "description": "agent-workflow assistant",
      "mode": "primary",
      "permission": {
        "agent-workflow_*": "deny",
        "edit": "allow",
        "external_directory": "deny",
        "question": "deny",
        "skill": {
          "*": "deny",
          "aw-assistant-charts": "allow",
          "aw-assistant-preview": "allow",
          "aw-db-readonly": "allow",
          "aw-office-docs": "allow",
          "aw-recurring-work": "allow",
          "aw-task-diagnosis": "allow",
          "aw-task-requirement": "allow",
        },
        "task": "deny",
        "webfetch": "ask",
      },
      "prompt": "<protocol-assistant.md>",
    },
    "aw-code-reviewer": {
      "description": "agent-workflow code_reviewer",
      "mode": "primary",
      "permission": {
        "agent-workflow-app_*": "deny",
        "edit": "deny",
        "external_directory": "deny",
        "question": "deny",
        "skill": "deny",
        "task": "deny",
        "webfetch": "deny",
        "websearch": "deny",
      },
      "prompt": "<protocol-code-review.md>",
    },
    "aw-companion": {
      "description": "companion small talk",
      "mode": "primary",
      "permission": {
        "*": "deny",
      },
      "prompt": "<protocol-companion.md>",
    },
    "aw-executor": {
      "description": "agent-workflow executor",
      "mode": "primary",
      "permission": {
        "agent-workflow-app_*": "deny",
        "edit": "allow",
        "external_directory": "deny",
        "question": "deny",
        "skill": {
          "*": "deny",
          "aw-db-readonly": "allow",
          "aw-merge-conflicts": "allow",
          "aw-offline-network": "allow",
          "aw-page-check": "allow",
        },
        "webfetch": "ask",
      },
      "prompt": "<protocol-execute.md>",
    },
    "aw-planner": {
      "description": "agent-workflow planner",
      "mode": "primary",
      "permission": {
        "agent-workflow-app_*": "deny",
        "edit": "deny",
        "external_directory": "deny",
        "question": "deny",
        "skill": {
          "*": "deny",
          "aw-db-readonly": "allow",
          "aw-offline-network": "allow",
          "aw-page-check": "allow",
        },
        "webfetch": "deny",
      },
      "prompt": "<protocol-plan.md>",
    },
    "aw-researcher": {
      "description": "agent-workflow researcher",
      "mode": "primary",
      "permission": {
        "agent-workflow-app_*": "deny",
        "edit": "deny",
        "external_directory": "deny",
        "question": "deny",
        "skill": {
          "*": "deny",
          "aw-db-readonly": "allow",
        },
        "task": "deny",
        "webfetch": "deny",
        "websearch": "deny",
      },
      "prompt": "<protocol-research.md>",
    },
    "aw-reviewer": {
      "description": "agent-workflow reviewer",
      "mode": "primary",
      "permission": {
        "agent-workflow-app_*": "deny",
        "edit": "deny",
        "external_directory": "deny",
        "question": "deny",
        "skill": {
          "*": "deny",
          "aw-db-readonly": "allow",
          "aw-page-check": "allow",
        },
        "webfetch": "deny",
      },
      "prompt": "<protocol-review.md>",
    },
    "aw-slides": {
      "description": "agent-workflow slides_writer",
      "mode": "primary",
      "permission": {
        "agent-workflow-app_*": "deny",
        "edit": "deny",
        "external_directory": "deny",
        "question": "deny",
        "skill": "deny",
        "task": "deny",
        "webfetch": "deny",
        "websearch": "deny",
      },
      "prompt": "<protocol-slides.md>",
    },
  },
  "mcp": {
    "agent-workflow": {
      "enabled": true,
      "headers": {
        "Authorization": "Bearer mcp-token",
      },
      "oauth": false,
      "type": "remote",
      "url": "http://127.0.0.1:4000/mcp/exec",
    },
    "agent-workflow-app": {
      "enabled": true,
      "headers": {
        "Authorization": "Bearer assistant-token",
      },
      "oauth": false,
      "type": "remote",
      "url": "http://127.0.0.1:4000/mcp/assistant",
    },
  },
  "skills": {
    "paths": [
      "/Applications/Agent Workflow.app/Contents/Resources/skills",
    ],
  },
}
`;

exports[`opencode 配置生成 > 离线环境下隐藏 opencode 自带的 provider、禁用 websearch（D168），在线时不设置 1`] = `
