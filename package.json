{
  "name": "agent-workflow",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "pnpm build:plugin && pnpm --filter @aw/desktop dev",
    "dev:server": "pnpm build:plugin && pnpm --filter @aw/server dev",
    "dev:web": "pnpm --filter @aw/web dev",
    "build": "pnpm build:plugin && pnpm --filter @aw/desktop build && node scripts/check-prod-bundle.mjs",
    "dist": "pnpm build:plugin && pnpm --filter @aw/desktop dist",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:deps": "depcruise apps packages --config .dependency-cruiser.cjs",
    "lint:css": "node scripts/lint-css.mjs",
    "gen:fsm-docs": "node scripts/gen-fsm-docs.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm lint:deps && pnpm lint:css && pnpm gen:fsm-docs --check",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project int",
    "test:oc": "pnpm build:plugin && vitest run --project oc",
    "test:live": "vitest run --project live",
    "e2e": "playwright test --project browser",
    "e2e:electron": "playwright test --project electron",
    "e2e:smoke": "playwright test launch.electron credentials.electron --project electron",
    "perf": "playwright test -c playwright.perf.config.ts",
    "verify": "pnpm check && pnpm test && pnpm test:int && pnpm build",
    "verify:full": "pnpm verify && pnpm test:oc && pnpm e2e",
    "build:plugin": "node --disable-warning=ExperimentalWarning scripts/build-opencode-plugin.ts"
  },
  "devDependencies": {
    "@aw/shared": "workspace:*",
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "dependency-cruiser": "18.6.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
